# InsightForge configuration
APP_NAME=InsightForge
HOST=127.0.0.1
PORT=8000

# Relative paths are resolved from the project root.
# Replace this with your own Excel workbook if required.
EXCEL_FILE=data/sample_financial_data.xlsx

# Set to true only when Power BI Desktop + the Power BI Modeling MCP
# are installed and your PBIX is open.
ENABLE_POWERBI_REFRESH=false

# Required only when ENABLE_POWERBI_REFRESH=true.
POWERBI_MCP_EXE=C:\Users\YOUR_USERNAME\.vscode\extensions\analysis-services.powerbi-modeling-mcp-1.0.0-win32-x64\server\powerbi-modeling-mcp.exe

POWERBI_REFRESH_TYPE=Full
WATCHER_DEBOUNCE_SECONDS=15
EXCEL_SAVE_WAIT_SECONDS=4

# Dashboard polls the API at this interval.
DASHBOARD_REFRESH_SECONDS=5
